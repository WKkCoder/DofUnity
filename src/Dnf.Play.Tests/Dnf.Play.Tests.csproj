<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dnf.Data\Dnf.Data.csproj" />
    <ProjectReference Include="..\Dnf.Script\Dnf.Script.csproj" />
    <ProjectReference Include="..\Dnf.Game\Dnf.Game.csproj" />
    <ProjectReference Include="..\Dnf.Render\Dnf.Render.csproj" />
    <ProjectReference Include="..\Dnf.Play\Dnf.Play.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 合成数据构造器(internal,直接编译进来)与"迷你职业 + 迷你怪物"夹具(与渲染层测试共用) -->
    <Compile Include="..\Dnf.Data.Tests\TestData.cs" Link="TestData.cs" />
    <Compile Include="..\Dnf.Render.Tests\AvatarFixture.cs" Link="AvatarFixture.cs" />
    <!-- 装扮衣柜的合成夹具(穿脱与外观接线的测试用,与渲染层测试共用) -->
    <Compile Include="..\Dnf.Render.Tests\WardrobeFixture.cs" Link="WardrobeFixture.cs" />
    <!-- 合成的方块字体(文字系统的测试用,不含真实字形) -->
    <Compile Include="..\Dnf.Render.Tests\BlockFont.cs" Link="BlockFont.cs" />
    <!-- 手工拼令牌脚本的构造器(金币掉落表的合成数据用) -->
    <Compile Include="..\Dnf.Game.Tests\TokenStreamBuilder.cs" Link="TokenStreamBuilder.cs" />
    <!-- 合成的脚本文件集合(任务目录的合成数据用) -->
    <Compile Include="..\Dnf.Game.Tests\Fixtures.cs" Link="Fixtures.cs" />
    <!-- 称号与成就的合成数据(小图鉴、成就目录、称号物品;称号会话的测试用,与规则层测试共用) -->
    <Compile Include="..\Dnf.Game.Tests\TitleFixtures.cs" Link="TitleFixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
