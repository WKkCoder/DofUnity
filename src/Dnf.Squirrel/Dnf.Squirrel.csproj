<Project Sdk="Microsoft.NET.Sdk">

  <!--
    源码的唯一来源是 UPM 包 packages/com.dnfunity.squirrel/Runtime。
    这个工程把同一批 .cs 文件编译成 netstandard2.1 程序集,供命令行工具与测试使用。
    原生库(Squirrel + 宿主封装)由 tools/build-squirrel.sh 构建到包的 Plugins 目录;
    这里把 macOS 版本复制到输出目录,让 .NET 的 DllImport("dnfsq") 能找到它。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Dnf.Squirrel</AssemblyName>
    <RootNamespace>Dnf.Squirrel</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\packages\com.dnfunity.squirrel\Runtime\**\*.cs" Link="Runtime\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="..\..\packages\com.dnfunity.squirrel\Plugins\macOS\libdnfsq.dylib" Link="libdnfsq.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
