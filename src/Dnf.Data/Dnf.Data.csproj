<Project Sdk="Microsoft.NET.Sdk">

  <!--
    源码的唯一来源是 UPM 包 packages/com.dnfunity.data/Runtime。
    这个工程只是把同一批 .cs 文件编译成 netstandard2.1 的程序集,供命令行工具与测试使用;
    Unity 通过包本身(asmdef)编译同一份源码。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Dnf.Data</AssemblyName>
    <RootNamespace>Dnf.Data</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\packages\com.dnfunity.data\Runtime\**\*.cs" Link="Runtime\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
